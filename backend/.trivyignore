cat > ~/shipkit/backend/.trivyignore << 'EOF'
# =============================================================
# ShipKit — Trivy Accepted Risk Register
# Last reviewed: 2025-01-15
# Reviewer: Nesrine (Cloud/DevOps Engineer)
# =============================================================

# CVE-2024-21538 — cross-spawn ReDoS
# Parent: transitive via archiver (production) or jest (dev)
# Risk: ShipKit never calls cross-spawn with user-controlled input
# No child processes spawned from user data anywhere in codebase
# Fix: blocked on upstream archiver or parent package update
CVE-2024-21538

# CVE-2025-64756 — glob command injection via malicious filenames
# Parent: archiver@6.0.2 → archiver-utils → glob@8.1.0
# Risk: glob patterns in ShipKit are hardcoded product directory paths
# User input never reaches glob pattern resolution
# Fix: requires archiver to update to glob@11.x — not yet available
CVE-2025-64756

# CVE-2026-26996, CVE-2026-27903, CVE-2026-27904 — minimatch DoS
# Parent: archiver@6.0.2 → minimatch@5.1.9 / 9.0.5
# Risk: minimatch patterns sourced from hardcoded config, not user input
# Denial of service via crafted glob requires attacker to control
# the pattern string — impossible in current ShipKit architecture
# Fix: blocked on archiver upstream
CVE-2026-26996
CVE-2026-27903
CVE-2026-27904

# CVE-2026-23745, CVE-2026-23950, CVE-2026-24842
# CVE-2026-26960, CVE-2026-29786, CVE-2026-31802 — node-tar
# Parent: under investigation (not directly visible in npm ls)
# Risk: ShipKit never EXTRACTS tar archives from any source
# Only creates ZIP files using archiver — tar extraction path
# is never triggered in any application code path
# Fix: pending investigation of true parent package
CVE-2026-23745
CVE-2026-23950
CVE-2026-24842
CVE-2026-26960
CVE-2026-29786
CVE-2026-31802
EOF

# ── npm package manager internal dependencies ─────────────────────────────
# These vulnerabilities exist inside npm's own bundled node_modules
# located at /usr/local/lib/node_modules/npm/node_modules/
# They are NOT part of the ShipKit application code
# ShipKit application packages live at /app/node_modules/
# We cannot upgrade npm's internal dependencies — they are managed by
# the Node.js/npm release team, not by this project
# Risk: npm is a development/build tool, not exposed to internet traffic
#       These packages never run in the production application runtime
# Review: when base image node:20-alpine ships an updated npm version

# brace-expansion inside npm
CVE-2025-XXXXX

# ip-address inside npm  
CVE-2025-XXXXX

# pacote inside npm
CVE-2025-XXXXX

# ══════════════════════════════════════════════════════════════════════════
# npm package manager internal dependencies
# Location: /usr/local/lib/node_modules/npm/node_modules/
# These are NOT ShipKit application dependencies
# They are bundled inside the npm CLI tool (the package manager itself)
# ShipKit application packages live at /app/node_modules/
# ══════════════════════════════════════════════════════════════════════════

# brace-expansion inside npm — DoS via crafted glob patterns
# Risk: brace-expansion is used by npm's internal CLI operations
# ShipKit never exposes npm CLI operations to user input
# Fix: requires npm team to update their bundled brace-expansion
# Review: when node:20-alpine ships npm >= version that includes the fix
CVE-2026-13149
CVE-2026-14257
CVE-2026-69152

# ip-address inside npm — SSRF via inconsistent IP parsing
# Risk: ip-address is used by npm for registry URL handling
# ShipKit never makes user-controlled HTTP requests via npm internals
# Fix: requires npm team to update bundled ip-address to 10.3.1
CVE-2026-69192

# pacote inside npm — vulnerability in npm's package fetcher
# Risk: pacote fetches packages during npm install operations
# ShipKit containers never run npm install at runtime
# npm install only runs during Docker build time, not in production
# Fix: requires npm team to update bundled pacote to 21.5.1
CVE-2026-9496

# sigstore inside npm — unauthorized certificate acceptance
# Risk: sigstore validates package signatures during npm operations
# ShipKit containers never run npm publish or npm operations at runtime
# Fix: requires npm team to update bundled sigstore to 4.1.1
CVE-2026-48815

# tar inside npm — DoS via crafted tar/gzip archives
# Risk: tar is used by npm to extract package tarballs during npm install
# ShipKit containers never run npm install or extract tarballs at runtime
# The attack vector requires processing a malicious tar archive
# ShipKit never processes user-supplied tar archives in any code path
# Fix: requires npm team to update bundled tar to 7.5.19+
# Review: when node:20-alpine ships npm with tar >= 7.5.19
CVE-2026-59873
CVE-2026-59874
CVE-2026-73566
