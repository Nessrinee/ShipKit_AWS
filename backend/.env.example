# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Security — CHANGE ALL OF THESE IN PRODUCTION ────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_64_char_random_hex_string
JWT_REFRESH_SECRET=CHANGE_ME_another_64_char_random_hex_string
LICENSE_SECRET=CHANGE_ME_hmac_secret_for_license_key_signing

# ─── Gumroad ─────────────────────────────────────────────────
# Your Gumroad store URL (for CORS allow)
GUMROAD_WEBHOOK_TOKEN=CHANGE_ME_gumroad_webhook_verification_token
GUMROAD_SELLER_ID=your-gumroad-seller-id

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Database ────────────────────────────────────────────────
DATABASE_PATH=./data/shipkit.db

# ─── Products ────────────────────────────────────────────────
# Path to the products/ directory (relative to backend/)
PRODUCTS_PATH=../products

# ─── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ─── Contact Form (optional SMTP) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECIPIENT=hello@yourdomain.com
